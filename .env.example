# Django API used by the storefront and the admin console.
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional: how this server reaches the API when that differs from the public URL,
# e.g. http://backend:8000 inside Docker. Not needed on Vercel.
API_INTERNAL_URL=

# Shown as the environment badge in the admin top bar: development, staging or production.
NEXT_PUBLIC_APP_ENV=development
