# Django backend, called from the Next.js server only (never from the browser).
API_URL=http://localhost:8000

# Web Push (VAPID) credentials. Generate a pair with: pnpm vapid:generate
# Leave empty to run the app with push notifications disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact for push services, either mailto: or https: URL.
VAPID_SUBJECT=mailto:admin@example.com
