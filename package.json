{
	"name": "aksara-frontend",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.21.0",
	"engines": {
		"node": ">=22.12.0"
	},
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome lint . && eslint . --max-warnings=0",
		"format": "biome format . --write",
		"check": "biome check . && eslint . --max-warnings=0 && next typegen && tsc --noEmit && vitest run",
		"type-check": "next typegen && tsc --noEmit",
		"test": "vitest run"
	},
	"dependencies": {
		"@radix-ui/react-label": "2.1.17",
		"@radix-ui/react-slot": "1.5.0",
		"@tanstack/react-query": "5.104.1",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"lucide-react": "1.59.0",
		"next": "16.4.0",
		"react": "19.3.0",
		"react-dom": "19.3.0",
		"sonner": "2.0.8",
		"tailwind-merge": "3.7.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@tailwindcss/postcss": "4.3.3",
		"@types/node": "24.19.2",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"eslint": "9.39.5",
		"eslint-config-next": "16.4.0",
		"postcss": "8.5.30",
		"tailwindcss": "4.3.3",
		"typescript": "5.9.3",
		"vitest": "5.0.3"
	}
}
